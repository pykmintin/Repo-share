# Copy to .env (gitignored). Replace all placeholders using YOUR own tenant and host.
# No OAuth access tokens, refresh tokens or client secrets go in this file.
# The audience MUST equal the public MCP resource URL for this example.
CLOUD_MCP_ISSUER=https://YOUR-TENANT.REGION.auth0.com/
CLOUD_MCP_AUDIENCE=https://YOUR-HOSTNAME/cloud/mcp
CLOUD_MCP_SUBJECT=YOUR-AUTH0-USER-ID
CLOUD_MCP_JWKS_URI=https://YOUR-TENANT.REGION.auth0.com/.well-known/jwks.json
CLOUD_MCP_RESOURCE_URL=https://YOUR-HOSTNAME/cloud/mcp
CLOUD_MCP_ALLOWED_CLIENTS=YOUR-CHATGPT-AUTH0-APP-CLIENT-ID
